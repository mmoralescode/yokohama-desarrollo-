{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-build-final/types/**/*.ts",
    ".next-build-final/dev/types/**/*.ts",
    ".next-proposal/types/**/*.ts",
    ".next-proposal/dev/types/**/*.ts",
    ".next-proposal-dev/types/**/*.ts",
    ".next-proposal-dev/dev/types/**/*.ts",
    ".next-admin/types/**/*.ts",
    ".next-admin/dev/types/**/*.ts",
    ".next-drivers-proposal/types/**/*.ts",
    ".next-drivers-proposal/dev/types/**/*.ts",
    ".next-drivers/types/**/*.ts",
    ".next-drivers/dev/types/**/*.ts",
    ".next-dashboard/types/**/*.ts",
    ".next-dashboard/dev/types/**/*.ts",
    ".next-dashboard-final/types/**/*.ts",
    ".next-dashboard-final/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
